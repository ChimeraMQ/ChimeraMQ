# ChimeraMQ Configuration Example
# Three Heads. One Binary. All Messages.
#
# Priority: CLI flags > env vars > YAML > defaults
# Env vars: CHIMERA_NODE_ID, CHIMERA_NODE_NAME, CHIMERA_DATA_DIR,
#           CHIMERA_LISTEN_PORT, CHIMERA_ADMIN_PORT,
#           CHIMERA_LOG_LEVEL, CHIMERA_LOG_FORMAT,
#           CHIMERA_AUTH_ENABLED, CHIMERA_TLS_ENABLED

# --- Node Identity ---
node:
  id: 1                              # Unique node ID (cluster scope)
  name: "chimera-01"                 # Human-readable node name
  data_dir: "/var/lib/chimera"       # Storage root directory

# --- Network Listeners ---
listener:
  bind: "0.0.0.0"                   # Bind address for all listeners
  port: 5672                         # Chimera native protocol (TCP)
  admin_port: 9090                   # HTTP admin API
  max_connections: 100000            # Max concurrent TCP connections

# --- Authentication (opt-in) ---
# auth:
#   enabled: false
#   type: "static"                   # static | file | mtls | oauth | ldap
#   tokens:                          # API key -> label mapping
#     "my-secret-token": "admin"
#   users:                           # username -> bcrypt hash
#     admin: "$2a$10$..."
#   auth_file: ""                    # JSON auth file path (type: file)
#   # oauth:                         # OAuth 2.0 / OIDC (type: oauth)
#   #   issuer: "https://auth.example.com"
#   #   client_id: "chimera"
#   #   client_secret: ""
#   #   scopes: ["openid", "profile"]
#   #   audience: "chimera-api"
#   # ldap:                          # LDAP (type: ldap)
#   #   url: "ldap://ldap.example.com:389"
#   #   bind_dn: "cn=chimera,ou=services,dc=example,dc=com"
#   #   bind_password: ""
#   #   base_dn: "ou=users,dc=example,dc=com"
#   #   filter: "(uid={username})"
#   #   tls: false

# --- TLS (opt-in) ---
# tls:
#   enabled: false
#   cert_file: "/etc/chimera/tls/server.crt"
#   key_file: "/etc/chimera/tls/server.key"
#   # ca_file: "/etc/chimera/tls/ca.crt"   # For mutual TLS
#   min_version: "1.3"
#   # mutual: false                        # Enable mTLS (requires client_ca)
#   # client_ca: "/etc/chimera/tls/ca.crt" # Client CA certificate

# --- Access Control Lists (Phase 7) — opt-in ---
# acl:
#   enabled: false
#   default_policy: "deny"           # allow | deny
#   entries:
#     - principal: "admin"
#       resource: "cluster"
#       name: "*"
#       operation: "all"
#       permission: "allow"
#     - principal: "*"
#       resource: "topic"
#       name: "public.*"
#       operation: "read"
#       permission: "allow"

# --- Resource Limits ---
limits:
  max_partitions_per_topic: 256      # Max partitions per topic (default: 256)
  max_topics: 1000                   # Max total topics (default: 1000)
  max_fetch_messages: 10000          # Max messages per fetch request (default: 10000)
  max_message_size: 16777216         # Max message payload in bytes (default: 16MB)
  max_connections: 10000             # Max concurrent TCP connections (default: 10000)

# --- Storage ---
storage:
  hot:
    segment_size: 268435456          # 256MB per log segment
    sync_mode: "interval"            # immediate | interval | os
    sync_interval: "200ms"           # Fsync interval (interval mode)
    max_segments: 10                 # Max segments per partition
  wal:
    max_size: 134217728              # 128MB max WAL file before rotation
    sync_mode: "interval"            # immediate | interval | os
    sync_interval: "100ms"           # Fsync interval (interval mode)
  tier_policy:
    hot_retention: "1h"              # Time before tier migration
    warm_retention: "24h"            # Warm tier retention
    cold_retention: "168h"           # Cold tier retention (7 days)
    hot_max_size: 0                  # Max hot tier bytes per partition (0=unlimited)
    warm_max_size: 0                 # Max warm tier bytes (0=unlimited)
    compact_on_migrate: false        # Run compaction during hot→warm

  # Warm tier (LSM-Tree) — opt-in
  # warm:
  #   enabled: false
  #   block_size: 65536               # SSTable block size (64KB)
  #   bloom_fp_rate: 0.01             # Bloom filter false positive rate
  #   compaction_strategy: "size_tiered"  # size_tiered | leveled | tombstone
  #   compaction_interval: "5m"       # Background compaction interval
  #   memtable_capacity: 4194304      # 4MB MemTable capacity before flush

  # Cold tier (compressed archives) — opt-in
  # cold:
  #   enabled: false
  #   archive_size: 1073741824        # 1GB target archive size
  #   compression: "zstd"             # Compression algorithm
  #   compression_level: 3            # Zstd compression level (1-22)
  #   dict_training_interval: 100     # Entries between dictionary training

  # At-rest encryption — opt-in
  # encryption:
  #   enabled: false
  #   algorithm: "aes-256-gcm"        # AES-256-GCM (only option)
  #   key_path: ""                    # Path to encryption key (auto-generated if empty)
  #   key_rotate: ""                  # Key rotation interval (empty = no rotation)

# --- Topic Defaults ---
defaults:
  topic:
    partitions: 8                    # Default partition count
    retention_time: "168h"           # 7 days
    mode: "unified"                  # stream | queue | unified
                                     #   stream: offset-based consumption, consumer groups
                                     #   queue:  competing consumers, ack/nack, DLQ
                                     #   unified: both simultaneously

# --- Logging ---
logging:
  level: "info"                      # debug | info | warn | error
  format: "json"                     # json | text
  output: "stdout"                   # stdout | file
  # file: "/var/log/chimera/chimera.log"  # Required when output: file

# --- Protocol Adapters (Phase 2) ---
# All protocols share the main TCP port (listener.port).
# Protocol is auto-detected from the first bytes of each connection.
# Detection order: TLS → AMQP → MQTT → HTTP/WS → Chimera native
protocols:
  chimera:
    enabled: true                     # Native Chimera protocol (default: enabled)
    max_frame_size: 16777216          # 16MB max frame size

  # MQTT 3.1.1 / 5.0 adapter
  # mqtt:
  #   enabled: false
  #   max_packet_size: 268435456       # 256MB max packet size
  #   max_qos: 2                       # Maximum supported QoS level
  #   max_topic_alias: 16              # MQTT 5.0 topic alias limit
  #   retained_max: 10000              # Max retained messages in memory
  #   topic_separator: "."             # ChimeraMQ separator (MQTT "/" → this)

  # WebSocket adapter
  # websocket:
  #   enabled: false
  #   path: "/ws"                      # WebSocket endpoint path
  #   max_frame_size: 16777216         # 16MB max frame size
  #   # Sub-protocols: chimera-json-v1, chimera-binary-v1

  # AMQP 1.0 adapter
  # amqp:
  #   enabled: false
  #   max_frame_size: 131072           # 128KB max frame size

# --- Geo-Replication (Phase 2) — opt-in ---
# geo_replication:
#   enabled: false
#   local_dc: "us-east-1"              # This datacenter's identifier
#   remote_dcs:                        # Remote datacenters to replicate to
#     - id: "eu-west-1"
#       name: "Europe West"
#       address: "eu-west-1.example.com:5675"  # Remote geo listener address
#       region: "eu-west-1"
#       topics: []                     # Whitelist: empty = replicate all topics
#       exclude_topics: ["__internal"] # Blacklist: never replicate these
#       tls:
#         enabled: false
#         cert_file: ""                # Client cert (mTLS)
#         key_file: ""                 # Client key (mTLS)
#         ca_file: ""                  # CA to verify server cert
#         skip_verify: false           # Skip TLS verification (testing only)
#       auth:
#         type: ""                     # token | basic | "" (none)
#         token: ""                    # Bearer token (type: token)
#         user: ""                     # Basic auth username (type: basic)
#         pass: ""                     # Basic auth password (type: basic)
#   replication_mode: "async"          # async | sync
#   batch_size: 100                    # Events per batch to remote DC
#   flush_interval: "1s"               # Max time before flushing buffer
#   max_lag: "30s"                     # Alert threshold for replication lag

# --- Clustering (Phase 3) ---
# cluster:
#   enabled: false                     # Enable clustered mode
#   raft:
#     peers:                           # Raft peer addresses (host:raft_port)
#       - "node-1.example.com:5673"
#       - "node-2.example.com:5673"
#       - "node-3.example.com:5673"
#     election_timeout: "1s"           # Raft election timeout
#     heartbeat_interval: "150ms"      # Leader heartbeat interval
#     snapshot_interval: "5m"          # Snapshot frequency
#     max_log_entries: 100000          # Entries before snapshot trigger
#   gossip:
#     bind_port: 5674                  # SWIM gossip UDP port
#     seeds:                           # Seed nodes for cluster discovery
#       - "node-1.example.com:5674"
#       - "node-2.example.com:5674"
#     probe_interval: "1s"             # Probe cycle interval
#     probe_timeout: "500ms"           # Per-probe timeout
#     indirect_nodes: 3                # K indirect probes on failure
#     suspicion_timeout: "5s"          # Suspect → Dead timeout
#   replication:
#     default_factor: 3                # Default replication factor
#     min_isr: 2                       # Min in-sync replicas for writes
#     ack_policy: "quorum"             # leader | quorum | all
#     sync_mode: "sync"                # sync | async
#     max_lag: 10000                   # Max offset lag before ISR shrink

# --- Schema Registry (Phase 5) — opt-in ---
# schema:
#   enabled: false
#   default_compat: "backward"         # none | backward | forward | full

# --- Priority Queues (Phase 5) — opt-in ---
# priority:
#   enabled: false
#   levels: 10                          # 0-9 priority levels (max 10)

# --- Message TTL (Phase 5) — opt-in ---
# ttl:
#   enabled: false
#   scan_interval: "1s"                # How often to scan for expired messages
#   default_action: "drop"             # drop | dlq

# --- WASM Runtime (Phase 6) — opt-in ---
# wasm:
#   enabled: false
#   max_memory_pages: 256              # 16MB per module instance
#   execution_timeout: "100ms"         # Transform execution timeout
#   module_pool_size: 4                # Pre-instantiated instances per module
#   modules_dir: ""                    # Auto-set to {data_dir}/wasm

# --- Stream Processing (Phase 6) — opt-in ---
# processing:
#   enabled: false
#   checkpoint_interval: "30s"         # State checkpoint frequency
#   state_dir: ""                      # Auto-set to {data_dir}/state

# --- Observability (Phase 7) — opt-in ---
# observability:
#   tracing:
#     enabled: false
#     endpoint: "localhost:4317"        # OTLP gRPC endpoint
#     service: "chimera"                # Service name for spans
#     insecure: true                    # Use insecure gRPC
#     sample_rate: 1.0                  # 0.0-1.0 trace sampling
#   dashboard:
#     enabled: true                     # Serve embedded Web UI at /ui/

# --- Dead Letter Queue (Phase 8) — opt-in ---
# dlq:
#   enabled: false
#   topic_prefix: "__dlq_"              # Prefix for DLQ topic names
#   max_retries: 3                      # Max retries before sending to DLQ

# --- Flow Control & Backpressure (Phase 8) — opt-in ---
# flow_control:
#   enabled: false
#   max_memory_bytes: 0                 # Memory limit (0 = no limit)
#   high_watermark: 0.85                # Reject publishes above this threshold
#   low_watermark: 0.70                 # Resume publishes below this threshold
#   max_connections: 0                  # Connection limit (0 = no limit)
#   global_rate_limit: 0                # Global msgs/sec (0 = unlimited)
#   slow_consumer_ttl: "30s"            # Time without delivery before slow check
#   max_slow_ticks: 3                   # Consecutive slow ticks before eviction

# --- Idempotent Producer (Phase 8) — opt-in ---
# idempotent:
#   enabled: false
#   window_size: "5m"                   # Deduplication window duration
#   max_entries: 10000                  # Max tracked entries per producer
